[TEMPLATE]
# Database — REQUIRED. For production, connect over TLS:
#   postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bugbounty"

# JWT — REQUIRED. Must be a unique, random secret in production; the app
# refuses to start if this is left at a known development default.
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Stripe — REQUIRED in production (escrow payments depend on these).
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Seed script (development)
# Optional known password for `npm run db:seed`. If unset, a random password
# is generated and never printed.
SEED_PASSWORD=""

# Admin
# Comma-separated emails allowed to access admin-only endpoints (log viewer).
# Alternatively, set a user's role to ADMIN directly in the database.
ADMIN_EMAILS=""

# Email (Resend)
# Get a key at https://resend.com/api-keys. Leave unset to skip sending
# (emails are logged as [REDACTED] instead).
RESEND_API_KEY="re_..."
# Must be a verified sender: onboarding@resend.dev works for testing only.
RESEND_EMAIL_FROM="onboarding@resend.dev"

# Sandbox
SANDBOX_API_URL="http://localhost:8000"
SANDBOX_TIMEOUT=30000

# App
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Runtime
# Set to "production" in deployed environments (enables strict env checks,
# generic error responses, secure cookies).
NODE_ENV="development"
# Log level for winston: error | warn | info | debug
LOG_LEVEL="info"
# Opt-in admin-only log viewer (see ADMIN_EMAILS).
ENABLE_LOG_VIEWER="false"

# Docker Compose (dev) additionally requires:
#   POSTGRES_PASSWORD - database password (no default; compose refuses to start without it)
